# Copy this file to "google-ads.yaml" (same folder) and fill in the real values.
# The real file is gitignored and will never be committed.
#
# NOTE: developer tokens were sunset by Google on 2026-09-09. Access level
# (Test / Explorer / Basic / Standard) now lives on your Google Cloud project
# instead, tied to whichever project your OAuth client belongs to. No
# developer_token field is needed here any more.

client_id: "YOUR_CLIENT_ID.apps.googleusercontent.com"   # from your OAuth desktop client JSON
client_secret: "YOUR_CLIENT_SECRET"            # from your OAuth desktop client JSON
refresh_token: "YOUR_REFRESH_TOKEN"            # generated by scripts/generate_refresh_token.py
login_customer_id: "YOUR_MANAGER_ACCOUNT_ID"   # digits only, no dashes - only needed if calling
                                                 # through a manager account. Can delete this line
                                                 # if you're accessing a standalone account directly.
use_proto_plus: true
